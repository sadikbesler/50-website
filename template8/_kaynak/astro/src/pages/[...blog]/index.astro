---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import merge from 'lodash.merge';
import type { ImageMetadata } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import SinglePost from '~/components/blog/SinglePost.astro';
import ToBlogLink from '~/components/blog/ToBlogLink.astro';

import { getCanonical, getPermalink, getBlogPermalink, getAsset } from '~/utils/permalinks';
import {
  getStaticPathsBlogPost,
  blogPostRobots,
  isBlogListRouteEnabled,
  isBlogCategoryRouteEnabled,
} from '~/utils/blog';
import { findImage } from '~/utils/images';
import { truncateAtWord } from '~/utils/utils';
import type { MetaData } from '~/types';
import RelatedPosts from '~/components/blog/RelatedPosts.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { SITE } from 'astrowind:config';
import { t, tr, trEn } from '~/utils/mizan';

export const prerender = true;

export const getStaticPaths = (async () => {
  return await getStaticPathsBlogPost();
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props as Props;

const url = String(getCanonical(getPermalink(post.permalink, 'post')));
const image = (await findImage(post.image)) as ImageMetadata | string | undefined;

const metadata = merge(
  {
    title: post.metadata?.title || post.title,
    // Search engines cut descriptions at about 155 characters; the full excerpt stays visible on the page.
    description: post.metadata?.description || truncateAtWord(post.excerpt, 155),
    canonical: url,
    robots: {
      index: blogPostRobots?.index,
      follow: blogPostRobots?.follow,
    },
    openGraph: {
      type: 'article',
      article: {
        publishedTime: post.publishDate.toISOString(),
        modifiedTime: (post.updateDate ?? post.publishDate).toISOString(),
        ...(post.author ? { authors: [post.author] } : {}),
        ...(post.category ? { section: post.category.title } : {}),
        ...(post.tags?.length ? { tags: post.tags.map((tag) => tag.title) } : {}),
      },
      ...(image
        ? {
            images: [
              typeof image === 'string'
                ? // Mizan: kapaklar public/assets/img/blog-*-1800.webp (1800×1125)
                  { url: image, width: 1800, height: 1125 }
                : { url: image, width: (image as ImageMetadata)?.width, height: (image as ImageMetadata)?.height },
            ],
          }
        : {}),
    },
  },
  {}
) as MetaData;

const imageUrl = typeof image === 'string' ? image : image?.src;

// Article structured data. The breadcrumb trail below carries its own BreadcrumbList.
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  datePublished: post.publishDate.toISOString(),
  dateModified: (post.updateDate ?? post.publishDate).toISOString(),
  ...(post.author ? { author: { '@type': 'Person', name: post.author, jobTitle: post.authorRole } } : {}),
  publisher: {
    '@type': 'Organization',
    name: 'Mizan Beslenme ve Diyet Kliniği',
    logo: { '@type': 'ImageObject', url: new URL(getAsset('/assets/icons/icon-512.png'), Astro.site).toString() },
  },
  inLanguage: 'tr-TR',
  ...(imageUrl ? { image: imageUrl.startsWith('http') ? imageUrl : new URL(imageUrl, Astro.site).toString() } : {}),
  ...(post.category ? { articleSection: post.category.title } : {}),
  ...(post.tags?.length ? { keywords: post.tags.map((tag) => tag.title).join(', ') } : {}),
  mainEntityOfPage: String(url),
};

const breadcrumbs = [
  { text: tr('crumbs.home'), html: t('crumbs.home'), href: getPermalink('/') },
  ...(isBlogListRouteEnabled ? [{ text: 'Blog', html: t('nav.blog'), href: getBlogPermalink() }] : []),
  ...(post.category && isBlogCategoryRouteEnabled
    ? [{ text: post.category.title, href: getPermalink(post.category.slug, 'category') }]
    : post.category
      ? [{ text: post.category.title, html: trEn(post.category.title, post.en?.category) }]
      : []),
  { text: post.title, html: trEn(post.title, post.en?.title) },
];
---

<Layout metadata={metadata} page="blog" titleEn={post.en?.metaTitle} descEn={post.en?.metaDescription}>
  <StructuredData slot="head" schema={articleSchema} />
  <Breadcrumbs bar hideCurrent items={breadcrumbs} />
  <SinglePost post={{ ...post, image: image }} url={url}>
    {post.Content && <post.Content />}
  </SinglePost>
  {/* Mizan: diyetisyen-v2'deki makale sonu çağrısı — AstroWind CallToAction kartı */}
  <CallToAction
    classes={{ container: 'pt-0 md:pt-0 lg:pt-0' }}
    title={t('article.ctaTitle')}
    subtitle={t('article.ctaText')}
    actions={[
      { variant: 'primary', text: t('article.ctaBtn'), href: getPermalink('/#randevu'), icon: 'tabler:calendar-event' },
    ]}
  />
  <ToBlogLink />
  <RelatedPosts post={post} />
</Layout>
