---
// Mizan: diyetisyen-v2 işaretlemesi (scripts/mizan-parcalar.py ile üretildi; elle düzenlemeyin).
---

<div class="tools-head">
  <div class="tabs" role="tablist" data-i18n-attr="aria-label:tools.aria" aria-label="Sağlık hesaplama araçları">
    <button class="tab" role="tab" type="button" id="tab-bmi" aria-controls="tool-bmi" aria-selected="true"><span data-i18n="tools.tab1">Vücut kitle indeksi</span><span class="mono" data-i18n="tools.tab1abbr">VKİ</span></button>
    <button class="tab" role="tab" type="button" id="tab-kcal" aria-controls="tool-kcal" aria-selected="false" tabindex="-1"><span data-i18n="tools.tab2">Günlük kalori</span><span class="mono">KCAL</span></button>
    <button class="tab" role="tab" type="button" id="tab-water" aria-controls="tool-water" aria-selected="false" tabindex="-1"><span data-i18n="tools.tab3">Su ihtiyacı</span><span class="mono">ML</span></button>
  </div>
</div>
<div class="tool" role="tabpanel" id="tool-bmi" aria-labelledby="tab-bmi">
  <form class="tool-card tool-form" data-tool="bmi" novalidate>
    <div class="range-field">
      <div class="range-top">
        <label class="field-label" for="bmi-height" data-i18n="tools.height">Boy</label>
        <div class="field-unit"><input class="field" id="bmi-height" name="height" type="number" inputmode="decimal" min="120" max="220" step="1" value="168"><span>cm</span></div>
      </div>
      <input type="range" min="120" max="220" step="1" value="168" data-sync="height" data-i18n-attr="aria-label:tools.height" aria-label="Boy">
    </div>
    <div class="range-field">
      <div class="range-top">
        <label class="field-label" for="bmi-weight" data-i18n="tools.weight">Kilo</label>
        <div class="field-unit"><input class="field" id="bmi-weight" name="weight" type="number" inputmode="decimal" min="35" max="220" step="0.1" value="68"><span>kg</span></div>
      </div>
      <input type="range" min="35" max="200" step="0.5" value="68" data-sync="weight" data-i18n-attr="aria-label:tools.weight" aria-label="Kilo">
    </div>
    <p class="tool-note" data-i18n="tools.bmiNote">VKİ; 18 yaş altı, gebelik dönemi ve kas kütlesi yüksek sporcular için yanıltıcı olabilir.</p>
  </form>
  <div class="tool-card tool-result" data-result="bmi" aria-live="polite"></div>
</div>
<div class="tool" role="tabpanel" id="tool-kcal" aria-labelledby="tab-kcal" hidden>
  <form class="tool-card tool-form" data-tool="kcal" novalidate>
    <div class="field-group">
      <span class="field-label" id="kcal-sex-l" data-i18n="tools.sex">Cinsiyet</span>
      <div class="radio-row" role="radiogroup" aria-labelledby="kcal-sex-l">
        <label class="radio-pill"><input type="radio" name="sex" value="f" checked><span data-i18n="tools.female">Kadın</span></label>
        <label class="radio-pill"><input type="radio" name="sex" value="m"><span data-i18n="tools.male">Erkek</span></label>
      </div>
    </div>
    <div class="form-grid form-grid--2">
      <div class="field-group">
        <label class="field-label" for="kcal-age" data-i18n="tools.age">Yaş</label>
        <div class="field-unit"><input class="field" id="kcal-age" name="age" type="number" inputmode="numeric" min="18" max="90" value="32"><span data-i18n="tools.years">yaş</span></div>
      </div>
      <div class="field-group">
        <label class="field-label" for="kcal-height" data-i18n="tools.height">Boy</label>
        <div class="field-unit"><input class="field" id="kcal-height" name="height" type="number" inputmode="decimal" min="120" max="220" value="168"><span>cm</span></div>
      </div>
      <div class="field-group span-2">
        <label class="field-label" for="kcal-weight" data-i18n="tools.weight">Kilo</label>
        <div class="field-unit"><input class="field" id="kcal-weight" name="weight" type="number" inputmode="decimal" min="35" max="220" step="0.1" value="68"><span>kg</span></div>
      </div>
    </div>
    <div class="field-group">
      <label class="field-label" for="kcal-activity" data-i18n="tools.activity">Hareket düzeni</label>
      <div class="select-wrap">
        <select class="field" id="kcal-activity" name="activity">
          <option value="1.2" data-i18n="tools.act1">Hareketsiz (masa başı, egzersiz yok)</option>
          <option value="1.375" data-i18n="tools.act2">Hafif aktif (haftada 1–3 gün)</option>
          <option value="1.55" selected data-i18n="tools.act3">Orta aktif (haftada 3–5 gün)</option>
          <option value="1.725" data-i18n="tools.act4">Çok aktif (haftada 6–7 gün)</option>
          <option value="1.9" data-i18n="tools.act5">Ekstra aktif (ağır iş veya günde iki antrenman)</option>
        </select>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </div>
    </div>
    <div class="field-group">
      <span class="field-label" id="kcal-goal-l" data-i18n="tools.goal">Hedef</span>
      <div class="radio-row" role="radiogroup" aria-labelledby="kcal-goal-l">
        <label class="radio-pill"><input type="radio" name="goal" value="lose" checked><span data-i18n="tools.lose">Kilo vermek</span></label>
        <label class="radio-pill"><input type="radio" name="goal" value="keep"><span data-i18n="tools.keep">Korumak</span></label>
        <label class="radio-pill"><input type="radio" name="goal" value="gain"><span data-i18n="tools.gain">Kilo almak</span></label>
      </div>
    </div>
  </form>
  <div class="tool-card tool-result" data-result="kcal" aria-live="polite"></div>
</div>
<div class="tool" role="tabpanel" id="tool-water" aria-labelledby="tab-water" hidden>
  <form class="tool-card tool-form" data-tool="water" novalidate>
    <div class="range-field">
      <div class="range-top">
        <label class="field-label" for="water-weight" data-i18n="tools.weight">Kilo</label>
        <div class="field-unit"><input class="field" id="water-weight" name="weight" type="number" inputmode="decimal" min="35" max="220" step="0.1" value="68"><span>kg</span></div>
      </div>
      <input type="range" min="35" max="200" step="0.5" value="68" data-sync="weight" data-i18n-attr="aria-label:tools.weight" aria-label="Kilo">
    </div>
    <div class="range-field">
      <div class="range-top">
        <label class="field-label" for="water-exercise" data-i18n="tools.exercise">Günlük egzersiz</label>
        <div class="field-unit"><input class="field" id="water-exercise" name="exercise" type="number" inputmode="numeric" min="0" max="240" step="5" value="30"><span data-i18n="tools.min">dk</span></div>
      </div>
      <input type="range" min="0" max="180" step="15" value="30" data-sync="exercise" data-i18n-attr="aria-label:tools.exercise" aria-label="Günlük egzersiz">
    </div>
    <div class="field-group">
      <span class="field-label" id="water-climate-l" data-i18n="tools.climate">Hava</span>
      <div class="radio-row" role="radiogroup" aria-labelledby="water-climate-l">
        <label class="radio-pill"><input type="radio" name="climate" value="normal" checked><span data-i18n="tools.normal">Normal</span></label>
        <label class="radio-pill"><input type="radio" name="climate" value="hot"><span data-i18n="tools.hot">Sıcak / nemli</span></label>
      </div>
    </div>
    <div class="field-group">
      <span class="field-label" id="water-status-l" data-i18n="tools.status">Özel durum</span>
      <div class="radio-row" role="radiogroup" aria-labelledby="water-status-l">
        <label class="radio-pill"><input type="radio" name="status" value="none" checked><span data-i18n="tools.none">Yok</span></label>
        <label class="radio-pill"><input type="radio" name="status" value="pregnant"><span data-i18n="tools.pregnant">Gebelik</span></label>
        <label class="radio-pill"><input type="radio" name="status" value="nursing"><span data-i18n="tools.nursing">Emzirme</span></label>
      </div>
    </div>
  </form>
  <div class="tool-card tool-result" data-result="water" aria-live="polite"></div>
</div>
