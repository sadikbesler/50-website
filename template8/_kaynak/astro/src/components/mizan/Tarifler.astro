// Mizan: diyetisyen-v2 işaretlemesi (scripts/mizan-parcalar.py ile üretildi; elle düzenlemeyin).
---

<div class="filter-row" role="group" data-i18n-attr="aria-label:recipes.filter" aria-label="Tarif kategorisi" data-recipe-filters>
  <button type="button" class="chip" aria-pressed="true" data-cat="all" data-i18n="recipes.all">Tümü</button>
  <button type="button" class="chip" aria-pressed="false" data-cat="breakfast" data-i18n="recipes.breakfast">Kahvaltı</button>
  <button type="button" class="chip" aria-pressed="false" data-cat="main" data-i18n="recipes.main">Ana yemek</button>
  <button type="button" class="chip" aria-pressed="false" data-cat="soup" data-i18n="recipes.soup">Çorba ve salata</button>
  <button type="button" class="chip" aria-pressed="false" data-cat="snack" data-i18n="recipes.snack">Ara öğün</button>
  <button type="button" class="chip" aria-pressed="false" data-cat="dessert" data-i18n="recipes.dessert">Tatlı</button>
</div>
<div class="recipes" data-recipes></div>
