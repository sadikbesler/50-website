---
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import { getCanonical, getPermalink } from '~/utils/permalinks';
import { t, tr, trEn } from '~/utils/mizan';

import type { MetaData } from '~/types';

// Mizan: AstroWind'in privacy.md düzeni (başlık + prose). Özgün KVKK sayfasındaki
// etiket ve özet iki dilli olarak başlığın üstüne/altına eklendi; metin src/pages/kvkk.md'de.
export interface Props {
  frontmatter: {
    title?: string;
    label?: string;
    lede?: string;
    metaTitle?: string;
    description?: string;
    en?: { title?: string; label?: string; lede?: string; metaTitle?: string; metaDescription?: string };
  };
}

const { frontmatter } = Astro.props;
const en = frontmatter.en ?? {};

const metadata: MetaData = {
  title: frontmatter.metaTitle || frontmatter.title,
  description: frontmatter.description,
  canonical: String(getCanonical(getPermalink(Astro.url.pathname.replace(/\.html$/, '').replace(/^.*\//, '/')))),
};
---

<Layout metadata={metadata} page="legal" titleEn={en.metaTitle} descEn={en.metaDescription}>
  <Breadcrumbs
    bar
    items={[
      { text: tr('crumbs.home'), html: t('crumbs.home'), href: getPermalink('/') },
      { text: 'KVKK' },
    ]}
  />
  <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-4xl">
    {
      frontmatter.label && (
        <p
          class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase"
          set:html={trEn(frontmatter.label, en.label)}
        />
      )
    }
    <h1
      class="font-bold font-heading text-4xl md:text-5xl leading-tighter tracking-tighter"
      set:html={trEn(frontmatter.title, en.title)}
    />
    {frontmatter.lede && <p class="mt-4 text-xl text-muted text-pretty" set:html={trEn(frontmatter.lede, en.lede)} />}
    <div
      class="mx-auto prose prose-lg max-w-4xl dark:prose-invert dark:prose-headings:text-slate-300 prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-primary dark:prose-a:text-blue-400 prose-img:rounded-md prose-img:shadow-lg mt-8"
    >
      <slot />
    </div>
  </section>
</Layout>
