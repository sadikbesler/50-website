---
import '~/assets/styles/tailwind.css';

import { I18N } from 'astrowind:config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import FontFiles from '~/components/common/FontFiles.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import Metadata from '~/components/common/Metadata.astro';
import Intersect from '~/components/common/Intersect.astro';

import { getAsset, getCanonical } from '~/utils/permalinks';

import type { MetaData as MetaDataType } from '~/types';

// Mizan: <ClientRouter /> (görünüm geçişleri), <ApplyColorMode /> (satır içi tema betiği),
// <Analytics /> ve <SiteVerification /> kaldırıldı:
// - Mizan betikleri her sayfada baştan çalışan klasik betikler; istemci tarafı gezinme onları yeniden başlatmaz.
// - CSP `script-src 'self'` satır içi betiğe izin vermez; temayı ilk boyamadan önce public/assets/js/boot.js koyar.
// - <Font /> satır içi <style> basar; aynı @font-face kuralları assets/css/fonts.css'ten gelir (FontFiles).

export interface Props {
  metadata?: MetaDataType;
  /** diyetisyen-v2'deki `data-page`: home | blog | legal (site.js ve chat.js okur) */
  page?: 'home' | 'blog' | 'legal';
  /** site.js dil EN olunca başlık ve açıklamayı bunlarla değiştirir */
  titleEn?: string;
  descEn?: string;
  /** Mizan betik takımı: ana sayfa hepsini, diğer sayfalar config/i18n/site/chat yükler */
  scripts?: 'home' | 'page';
}

const { metadata = {}, page = 'home', titleEn, descEn, scripts = 'page' } = Astro.props;
const { language, textDirection } = I18N;

const root = getAsset('/') + '/';
const canonical = String(metadata.canonical || getCanonical(String(Astro.url.pathname)));
const js = (name: string) => getAsset(`/assets/js/${name}.js`);
const mizanScripts =
  scripts === 'home'
    ? ['config', 'i18n', 'site', 'booking', 'tools', 'content', 'chat']
    : ['config', 'i18n', 'site', 'chat'];
---

<!doctype html>
<html
  lang={language}
  dir={textDirection}
  class="no-js 2xl:text-[20px]"
  data-theme="light"
  data-root={root}
  data-page={page}
  data-title-en={titleEn}
  data-desc-en={descEn}
>
  <head>
    <CommonMeta />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://script.google.com https://script.googleusercontent.com; manifest-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-src 'none'"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#FFFFFF" />
    <meta name="format-detection" content="telephone=no" />
    <Favicons />
    <FontFiles />
    <CustomStyles />

    <!-- Tema ve dil ilk boyamadan önce (AstroWind'in satır içi ApplyColorMode betiğinin yerine) -->
    <script is:inline src={js('boot')}></script>

    <Metadata {...metadata} canonical={canonical} />
    <link rel="alternate" hreflang="tr" href={canonical} />
    <link rel="alternate" hreflang="en" href={`${canonical}?lang=en`} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    {mizanScripts.map((name) => <script is:inline src={js(name)} defer></script>)}

    <!-- Extra head content from pages: structured data, rel=prev/next, … -->
    <slot name="head" />
  </head>

  <body class="antialiased text-default bg-page tracking-tight min-h-screen flex flex-col">
    <a class="skip-link" href="#main" data-i18n="a11y.skip">İçeriğe geç</a>
    <slot />

    <Intersect />
  </body>
</html>
