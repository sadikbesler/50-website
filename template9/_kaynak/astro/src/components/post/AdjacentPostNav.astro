---
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";

// AstroPaper AdjacentPostNav.astro (başlıklar TR/EN; text-accent/85 → text-accent: %85 opaklık 4,5:1'in altında). diyetisyen-v2'deki "Diğer yazılar" bölümünün yerini alır.
type AdjacentPost = {
  id: string;
  title: string;
  titleEn: string;
  filePath: string | undefined;
} | null;

type Props = {
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { prevPost, nextPost } = Astro.props;
const t = useTranslations(config.site.lang);
---

<div data-pagefind-ignore class="my-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
  {
    prevPost && (
      <a
        href={getPostUrl(prevPost.id, prevPost.filePath)}
        class="flex w-full gap-1 hover:opacity-75"
      >
        <IconArrowLeft class="inline-block flex-none rtl:rotate-180" />
        <div>
          <span data-i18n="ap.post.previousPost">{t.post.previousPost}</span>
          <div class="text-accent text-sm"><span data-lang-block="tr">{prevPost.title}</span><span data-lang-block="en" lang="en">{prevPost.titleEn}</span></div>
        </div>
      </a>
    )
  }
  {
    nextPost && (
      <a
        href={getPostUrl(nextPost.id, nextPost.filePath)}
        class="flex w-full justify-end gap-1 text-end hover:opacity-75 sm:col-start-2"
      >
        <div>
          <span data-i18n="ap.post.nextPost">{t.post.nextPost}</span>
          <div class="text-accent text-sm"><span data-lang-block="tr">{nextPost.title}</span><span data-lang-block="en" lang="en">{nextPost.titleEn}</span></div>
        </div>
        <IconArrowRight class="inline-block flex-none rtl:rotate-180" />
      </a>
    )
  }
</div>
