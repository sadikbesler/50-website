---
import IconArrowNarrowUp from "@/assets/icons/IconArrowNarrowUp.svg";
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import { getAssetPath } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

// AstroPaper Footer.astro (alt satır: sosyal bağlantılar + telif). Üstüne Mizan footer'ının zorunlu
// içeriği AstroPaper'ın düz satır tipografisiyle eklendi: klinik/kaynak/iletişim bağlantıları,
// sağlık uyarısı, KVKK, Asteria imzası, başa dön.
type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const t = useTranslations(config.site.lang);
const currentYear = new Date().getFullYear();
const home = (hash: string) => getAssetPath(hash);
---

<footer
  class:list={["site-footer app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="border-border grid grid-cols-[minmax(0,1fr)] gap-3 border-t py-6 text-sm">
    <p><b class="font-semibold" data-i18n="footer.about">Mizan Beslenme</b> · <span data-i18n="footer.aboutText">2014’ten beri Kadıköy’de yüz yüze, 2020’den beri online beslenme danışmanlığı veren diyet kliniği.</span></p>
    <nav class="footer-links" aria-label="Klinik" data-i18n-attr="aria-label:footer.clinic">
      <span class="text-muted-foreground" data-i18n="footer.clinic">Klinik</span>:{" "}
      <a href={home("#hizmetler")} data-i18n="nav.services">Hizmetler</a>
      {" "}<span aria-hidden="true">|</span>{" "}
      <a href={home("#uzmanlar")} data-i18n="nav.team">Uzmanlar</a>
      {" "}<span aria-hidden="true">|</span>{" "}
      <a href={home("#ucretler")} data-i18n="nav.pricing">Ücretler</a>
      {" "}<span aria-hidden="true">|</span>{" "}
      <a href={home("#randevu")} data-i18n="nav.book">Randevu al</a>
    </nav>
    <nav class="footer-links" aria-label="Kaynaklar" data-i18n-attr="aria-label:footer.resources">
      <span class="text-muted-foreground" data-i18n="footer.resources">Kaynaklar</span>:{" "}
      <a href={home("#araclar")} data-i18n="footer.bmi">VKİ ve kalori hesaplama</a>
      {" "}<span aria-hidden="true">|</span>{" "}
      <a href={home("#program")} data-i18n="nav.program">Örnek program</a>
      {" "}<span aria-hidden="true">|</span>{" "}
      <a href={home("#tarifler")} data-i18n="nav.recipes">Tarifler</a>
      {" "}<span aria-hidden="true">|</span>{" "}
      <a href={getAssetPath("blog/")} data-i18n="nav.blog">Blog</a>
      {" "}<span aria-hidden="true">|</span>{" "}
      <a href={home("#sss")} data-i18n="nav.faq">SSS</a>
    </nav>
    <div class="footer-links">
      <span class="text-muted-foreground" data-i18n="nav.contact">İletişim</span>:{" "}
      <span data-address>Moda Cad. No: 48, Kat 3, Kadıköy / İstanbul</span>
      {" "}<span aria-hidden="true">|</span>{" "}
      <a href="tel:+905555555555" data-tel data-phone-text>0555 555 55 55</a>
      {" "}<span aria-hidden="true">|</span>{" "}
      <a href="mailto:randevu@mizanbeslenme.com" data-mail>randevu@mizanbeslenme.com</a>
      {" "}<span aria-hidden="true">|</span>{" "}
      <a href="https://instagram.com/mizanbeslenme" target="_blank" rel="noopener noreferrer">Instagram</a>
    </div>
    <p class="footer-disclaimer text-muted-foreground" data-i18n="footer.disclaimer">Bu sitedeki içerikler genel bilgilendirme amaçlıdır; tanı ve tedavinin yerine geçmez. Sağlık sorunlarınız için hekiminize danışın, acil durumlarda 112’yi arayın.</p>
  </div>
  <div
    class="border-border flex flex-col items-center justify-between border-t py-6 sm:flex-row-reverse sm:py-4"
  >
    <Socials />
    <div class="my-2 flex flex-col items-center whitespace-nowrap sm:flex-row">
      <span><span data-i18n="ap.footer.copyright">{t.footer.copyright}</span> &#169; <span data-year>{currentYear}</span> Mizan Beslenme</span>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <a href={getAssetPath("kvkk.html")} class="underline decoration-dashed underline-offset-4 hover:text-accent" data-i18n="footer.kvkk">KVKK aydınlatma metni</a>
    </div>
  </div>
  <div class="flex flex-col items-center justify-between gap-2 pb-6 text-sm sm:flex-row">
