---
import IconUnderline from "@/assets/icons/IconUnderline.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";
import LinkButton from "./LinkButton.astro";
import { getAssetPath, stripBase } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

// AstroPaper Header.astro. Mizan eklemeleri: #site-header kimliği, "Blog" (= AstroPaper "Posts"),
// TR/EN düğmeleri ([data-lang], site.js) ve tema düğmesi ([data-theme-toggle], site.js).
const { features } = config;
const t = useTranslations(config.site.lang);

const relativePath = stripBase(Astro.url.pathname);
const currentPath =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath.replace(/\.html$/, "");

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
  data-i18n="a11y.skip"
>
  {t.a11y.skipToContent}
</a>

<header
  id="site-header"
  class="app-layout flex flex-col items-center justify-between sm:flex-row"
>
  <div
    class="border-border bg-background relative flex w-full items-baseline justify-between border-b py-4 sm:items-center sm:py-6"
  >
    <a
      href={getAssetPath("")}
      class="absolute py-1 text-xl leading-8 font-semibold whitespace-nowrap sm:static sm:my-auto sm:text-2xl sm:leading-none"
      translate="no"
      aria-label="Mizan Beslenme ana sayfa"
      data-i18n-attr="aria-label:a11y.home"
    >
      mizan
    </a>
    <nav
      id="nav-menu"
      class="flex w-full flex-col items-center sm:ms-2 sm:flex-row sm:justify-end sm:space-x-4 sm:py-0"
      aria-label="Ana menü"
      data-i18n-attr="aria-label:a11y.mainNav"
    >
      <button
        id="menu-btn"
        class="focus-outline self-end p-2 sm:hidden"
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        aria-controls="menu-items"
      >
        <IconX id="close-icon" class="hidden" />
        <IconMenuDeep id="menu-icon" />
      </button>
      <ul
        id="menu-items"
        class="[&>li>a]:hover:text-accent mt-4 hidden w-44 grid-cols-2 place-content-center gap-2 sm:mt-0 sm:flex sm:w-auto sm:gap-x-3 md:gap-x-5 sm:gap-y-0 sm:[&>li]:h-8 [&>li>a]:block [&>li>a]:px-4 [&>li>a]:py-3 [&>li>a]:text-center [&>li>a]:font-medium sm:[&>li>a]:px-2 sm:[&>li>a]:py-1"
      >
        <li class="col-span-2">
          <a
            href={getAssetPath("blog/")}
            class:list={{ "active-nav": isActive("/blog") }}
            data-i18n="nav.blog"
          >
            Blog
          </a>
        </li>
        <li class="col-span-2">
          <a
            href={getAssetPath("tags/")}
            class:list={{ "active-nav": isActive("/tags") }}
            data-i18n="ap.nav.tags"
          >
            {t.nav.tags}
          </a>
        </li>
        <li class="col-span-2">
          <a
            href={getAssetPath("about/")}
            class:list={{ "active-nav": isActive("/about") }}
            data-i18n="ap.nav.about"
          >
            {t.nav.about}
          </a>
        </li>
        {
          features.showArchives && (
            <li class="col-span-2">
              <LinkButton
                href={getAssetPath("archives/")}
                class:list={[
                  "focus-outline flex size-full justify-center p-3 sm:relative sm:size-8 sm:p-0",
                  { "active-nav": isActive("/archives") },
                ]}
                title={t.nav.archives}
                aria-label={t.nav.archives}
                data-i18n-attr="title:ap.nav.archives;aria-label:ap.nav.archives"
              >
                <IconArchive class="hidden sm:absolute sm:top-1/2 sm:left-1/2 sm:block sm:size-6 sm:-translate-x-1/2 sm:-translate-y-1/2" />
                <span class="sm:sr-only" data-i18n="ap.nav.archives">{t.nav.archives}</span>
                {isActive("/archives") && (
                  <IconUnderline
                    aria-hidden="true"
                    class="scale-125 max-sm:hidden sm:absolute sm:bottom-0 sm:w-6"
                  />
                )}
              </LinkButton>
            </li>
          )
        }
        {
          features.search !== false && (
            <li class="col-span-1 flex items-center justify-center">
              <LinkButton
                href={getAssetPath("search/")}
                class:list={["focus-outline relative size-8"]}
                title={t.nav.search}
                aria-label={t.nav.search}
                data-i18n-attr="title:ap.nav.search;aria-label:ap.nav.search"
              >
                <IconSearch class="absolute top-1/2 left-1/2 size-6 -translate-x-1/2 -translate-y-1/2" />
                <span class="sr-only" data-i18n="ap.nav.search">{t.nav.search}</span>
                {isActive("/search") && (
                  <IconUnderline
                    aria-hidden="true"
                    class="absolute bottom-0 w-6 scale-125 max-sm:inset-s-2"
                  />
                )}
              </LinkButton>
            </li>
          )
        }
        {
          features.lightAndDarkMode && (
            <li class="col-span-1 flex items-center justify-center">
              <button
                type="button"
                data-theme-toggle
                class="focus-outline hover:[&>svg]:stroke-accent relative size-12 p-4 sm:size-8"
                aria-label="Koyu temaya geç"
              >
                <IconMoon class="absolute top-[50%] left-[50%] translate-[-50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                <IconSunHigh class="absolute top-[50%] left-[50%] translate-[-50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
              </button>
            </li>
          )
        }
        <li class="col-span-2 flex items-center justify-center">
          <div
            class="lang-switch flex items-center gap-1"
            role="group"
            aria-label="Dil seçimi"
            data-i18n-attr="aria-label:a11y.lang"
          >
            <button type="button" class="lang-btn" data-lang="tr" aria-pressed="true" lang="tr">TR</button>
            <span aria-hidden="true" class="text-muted-foreground">/</span>
            <button type="button" class="lang-btn" data-lang="en" aria-pressed="false" lang="en">EN</button>
          </div>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // AstroPaper'ın menü betiği; etiketler dil değişince Mizan.t ile güncellenir.
  function toggleNav() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    const M = (window as unknown as { Mizan?: { t: (k: string) => string; onLang: (fn: () => void) => void } }).Mizan;
    const label = () => {
      const open = menuBtn.getAttribute("aria-expanded") === "true";
      const key = open ? "a11y.menuClose" : "a11y.menuOpen";
      menuBtn.setAttribute("aria-label", M ? M.t(key) : menuBtn.getAttribute("aria-label") ?? "");
    };

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      label();

      menuItems.classList.toggle("hidden");
      menuItems.classList.toggle("grid");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
    if (M) M.onLang(label);
  }

  function handleSkipToContent() {
    const skipLink = document.getElementById("skip-to-content");
    if (!skipLink) return;
    skipLink.addEventListener("click", e => {
      if (
        e.defaultPrevented ||
        e.metaKey ||
        e.ctrlKey ||
        e.shiftKey ||
        e.button !== 0
      )
        return;
      e.preventDefault();
      const target = document.getElementById("main-content");
      if (target) {
        target.setAttribute("tabindex", "-1");
        target.addEventListener(
          "blur",
          () => target.removeAttribute("tabindex"),
          {
            once: true,
          }
        );
        target.focus();
        target.scrollIntoView({ behavior: "smooth" });
      }
    });
  }

  toggleNav();
  handleSkipToContent();
</script>
