---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import kvkk from "@/data/kvkk.html?raw";

// kvkk.html (build.format "preserve" → kvkk.html). AstroPaper'ın "about" sayfa düzeni: Breadcrumb + Main + app-prose.
// Metin diyetisyen-v2 kvkk.html'den birebir (anasayfa-kur.py → src/data/kvkk.html); yalnızca Google Fonts
// cümlesi çıkarıldı (bu şablonda yazı tipi siteden sunuluyor).
---

<Layout
  title="KVKK Aydınlatma Metni ve Gizlilik | Mizan Beslenme"
  description="Mizan Beslenme ve Diyet Kliniği’nin kişisel ve sağlık verilerini hangi amaçlarla işlediği, sakladığı ve KVKK kapsamındaki haklarınız."
  titleEn="Privacy Notice (KVKK) | Mizan Nutrition"
  descEn="How Mizan Nutrition & Dietetics Clinic processes and stores personal and health data, and your rights under Turkey’s data protection law."
>
  <Header />

  <Breadcrumb />

  <Main class="app-prose">
    <Fragment slot="title"><span data-lang-block="tr">KVKK aydınlatma metni ve gizlilik</span><span data-lang-block="en" lang="en">Privacy notice (KVKK)</span></Fragment>
    <Fragment slot="desc"><span data-lang-block="tr">Randevu ve iletişim formlarında paylaştığınız bilgileri nasıl işlediğimizi, ne kadar sakladığımızı ve haklarınızı açık bir dille anlatıyoruz.</span><span data-lang-block="en" lang="en">How we handle the information you share through our booking and contact forms, how long we keep it, and your rights, in plain language.</span></Fragment>
    <Fragment set:html={kvkk} />
  </Main>

  <Footer />
</Layout>
