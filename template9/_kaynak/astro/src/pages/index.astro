---
// Ana sayfa. Kaynak şablon: _kaynak/sayfa/index.sablon.astro → `python3 _kaynak/anasayfa-kur.py` ile
// astro/src/pages/index.astro üretilir (parca yer tutucularının yerine diyetisyen-v2'nin işaretlemesi girer).
//
// AstroPaper ana sayfa kalıbı korunur: giriş (#hero → #top) + "Featured" başlık stiliyle bölümler +
// "Recent posts" (6 Mizan makalesi, Card) + "All posts" bağlantısı.
import { getCollection } from "astro:content";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import IconHash from "@/assets/icons/IconHash.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getAssetPath } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";
import TR from "@/data/tr.json";

const { posts: postsConfig } = config;
const t = useTranslations(config.site.lang);
// Türkçe metin diyetisyen-v2'den (anasayfa-kur.py → src/data/tr.json); eksik anahtar derlemeyi durdurur.
const T = (k: string): string => {
  const v = (TR as Record<string, string>)[k];
  if (v == null) throw new Error("tr.json'da yok: " + k);
  return v;
};

const posts = await getCollection("posts");
const recentPosts = getSortedPosts(posts);

const SITE = "https://sadikbesler.github.io/50-website/template9/";
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE}#website`,
      url: SITE,
      name: "Mizan Beslenme",
      inLanguage: ["tr-TR", "en-US"],
    },
    {
      "@type": "MedicalClinic",
      "@id": `${SITE}#clinic`,
      name: "Mizan Beslenme ve Diyet Kliniği",
      url: SITE,
      image: `${SITE}assets/img/og-image.jpg`,
      logo: `${SITE}assets/icons/apple-touch-icon.png`,
      description:
        "Kadıköy’de uzman diyetisyenlerle kilo yönetimi, klinik beslenme, sporcu beslenmesi, gebelik ve çocuk beslenmesi danışmanlığı. Yüz yüze ve online görüşme.",
      medicalSpecialty: "https://schema.org/DietNutrition",
      telephone: "+905555555555",
      email: "randevu@mizanbeslenme.com",
      priceRange: "₺₺",
      currenciesAccepted: "TRY",
      paymentAccepted: "Nakit, Kredi kartı, Havale",
      address: {
        "@type": "PostalAddress",
        streetAddress: "Moda Cad. No: 48, Kat 3",
        addressLocality: "Kadıköy",
        addressRegion: "İstanbul",
        postalCode: "34710",
        addressCountry: "TR",
      },
      openingHoursSpecification: [
        { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], opens: "09:00", closes: "20:00" },
        { "@type": "OpeningHoursSpecification", dayOfWeek: "Saturday", opens: "10:00", closes: "15:00" },
      ],
      availableService: [
        { "@type": "MedicalTherapy", name: "Kilo yönetimi danışmanlığı" },
        { "@type": "MedicalTherapy", name: "Klinik beslenme (insülin direnci, diyabet, PCOS, tiroit)" },
        { "@type": "MedicalTherapy", name: "Sporcu beslenmesi" },
        { "@type": "MedicalTherapy", name: "Gebelik ve emzirme döneminde beslenme" },
        { "@type": "MedicalTherapy", name: "Çocuk ve ergen beslenmesi" },
        { "@type": "MedicalTherapy", name: "Online diyet danışmanlığı" },
      ],
      employee: [
        { "@type": "Person", name: "Selin Karaca", jobTitle: "Uzman Diyetisyen" },
        { "@type": "Person", name: "Emre Aksoy", jobTitle: "Diyetisyen" },
        { "@type": "Person", name: "Zeynep Tunalı", jobTitle: "Diyetisyen" },
      ],
      sameAs: ["https://instagram.com/mizanbeslenme"],
    },
  ],
};
const faqLd = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: [] };

// Bölüm başlığı: AstroPaper ana sayfasındaki "Featured"/"Recent Posts" başlığı
const H2 = "text-2xl font-semibold tracking-wide";
const SECTION = "border-border border-b pt-12 pb-6";
const LEDE = "mt-2 mb-2 italic";
// AstroPaper giriş bölümündeki "README" bağlantısı (LinkButton + kesikli alt çizgi)
const LINK = "hover:text-accent underline decoration-dashed underline-offset-4";
// AstroPaper Card başlığı
const CARD_TITLE = "text-accent inline-block text-lg font-medium decoration-dashed underline-offset-4 hover:underline focus-visible:no-underline focus-visible:underline-offset-0";
const META = "text-muted-foreground flex flex-wrap items-center gap-x-2 text-sm";

const services = [
  { n: 1, img: "hizmet-kilo", area: "weight", tags: ["s1.tag1", "s1.tag2", "s1.tag3"] },
  { n: 2, img: "hizmet-klinik", area: "clinical", tags: ["s2.tag1", null, "s2.tag3", "s2.tag4"] },
  { n: 3, img: "hizmet-sporcu", area: "sports", tags: ["s3.tag1", "s3.tag2"] },
  { n: 4, img: "hizmet-gebelik", area: "pregnancy", tags: ["s4.tag1", "s4.tag2"] },
  { n: 5, img: "hizmet-cocuk", area: "kids", tags: ["s5.tag1", "s5.tag2"] },
  { n: 6, img: "hizmet-online", type: "online", tags: ["s6.tag1", "s6.tag2"] },
];
---

<Layout
  title="Diyetisyen Kadıköy | Mizan Beslenme ve Diyet Kliniği · Online Randevu"
  description="Kadıköy Moda’da uzman diyetisyenlerle kilo yönetimi, insülin direnci, sporcu, gebelik ve çocuk beslenmesi. Yüz yüze veya online görüşme için hemen randevu alın."
  ogTitle="Diyetisyen web sitesi · Template 9 (AstroPaper)"
  ogDesc="AstroPaper'ın sade, monospace blog tasarımıyla diyetisyen sitesi: online randevu, hesaplama araçları, tarifler, aranabilir blog."
  page="home"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />
    <script type="application/ld+json" id="faq-schema" is:inline set:html={JSON.stringify(faqLd)} />
  </Fragment>

  <Header />
  <main id="main-content" data-layout="index" class="app-layout my-1">
    <!-- S2 · Giriş (AstroPaper #hero) -->
    <section id="top" class="border-border border-b pt-8 pb-6" aria-labelledby="hero-title">
      <h1 id="hero-title" class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl" data-i18n="hero.title">
        Sofranıza uyan bir beslenme planı.
      </h1>
      <a
        target="_blank"
        href={getAssetPath("rss.xml")}
        class="inline-block"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>
      <p class="mb-2 italic" data-i18n="hero.kicker">Moda, Kadıköy · Yüz yüze ve online</p>
      <p data-i18n="hero.lede">İlk görüşmede tahlillerinize bakıyor ve vücut analizi yapıyoruz. Planınız iş saatlerinize ve sevdiğiniz yemeklere göre hazırlanıyor, kontrol görüşmelerinde birlikte güncelleniyor.</p>
      <p class="hero-cta mt-2">
        <LinkButton class={LINK} href="#randevu"><span data-i18n="hero.cta1">Randevu al</span></LinkButton>
        <span aria-hidden="true">&nbsp;·&nbsp;</span>
        <LinkButton class={LINK} href="#araclar"><span data-i18n="hero.cta2">VKİ’nizi hesaplayın</span></LinkButton>
      </p>
      <div class="mt-4 flex max-sm:flex-col sm:items-center">
        <div class="me-2 mb-1 whitespace-nowrap sm:mb-0"><span data-i18n="ap.home.socialLinks">{t.home.socialLinks}</span>:</div>
        <Socials />
      </div>

      <!-- #next-slot: AstroPaper Card düzeni (başlık = saat, tarih satırı = etiket, açıklama = uzman) -->
      <aside class="next-slot my-6" id="next-slot" aria-live="polite" data-i18n-attr="aria-label:next.aria" aria-label="En yakın uygun randevu">
        <p class="text-accent inline-block text-lg font-medium" data-next-time><span data-i18n="next.loading">Takvim kontrol ediliyor…</span></p>
        <div class={META}>
          <IconCalendar class="inline-block size-6 min-w-5.5 scale-90" />
          <span data-i18n="next.label">En yakın uygun randevu</span>
        </div>
        <p data-next-meta>&nbsp;</p>
        <LinkButton class={LINK} href="#randevu" data-next-book>
          <span data-i18n="next.book">Bu saati ayır</span>
          <IconArrowRight class="inline-block size-5 rtl:-rotate-180" />
        </LinkButton>
      </aside>

      <!-- AstroPaper'ın katlanır içindekiler kalıbı (remark-collapse çıktısı) -->
      <div class="home-toc app-prose max-w-app">
      <details>
        <summary data-i18n="ap.home.toc">Bu sayfada</summary>
        <ul>
          <li><a href="#hizmetler" data-i18n="nav.services">Hizmetler</a></li>
          <li><a href="#yaklasim" data-i18n="tag.process">Yöntem</a></li>
          <li><a href="#uzmanlar" data-i18n="nav.team">Uzmanlar</a></li>
          <li><a href="#araclar" data-i18n="nav.tools">Araçlar</a></li>
          <li><a href="#program" data-i18n="nav.program">Örnek program</a></li>
          <li><a href="#tarifler" data-i18n="nav.recipes">Tarifler</a></li>
          <li><a href="#ucretler" data-i18n="nav.pricing">Ücretler</a></li>
          <li><a href="#randevu" data-i18n="nav.book">Randevu al</a></li>
          <li><a href="#blog" data-i18n="nav.blog">Blog</a></li>
          <li><a href="#sss" data-i18n="nav.faq">SSS</a></li>
          <li><a href="#iletisim" data-i18n="nav.contact">İletişim</a></li>
        </ul>
      </details>
      </div>
    </section>

    <!-- S3 · Kısa bilgiler -->
    <section class:list={["facts", SECTION]} aria-labelledby="facts-title">
      <h2 id="facts-title" class={H2} data-i18n="facts.aria">Klinik hakkında kısa bilgiler</h2>
      <ul class="facts-list grid sm:grid-cols-2 sm:gap-x-8">
        <li class="my-6"><p class="text-accent text-lg font-medium">12 <span data-i18n="facts.1u">yıl</span></p><p data-i18n="facts.1">klinik beslenme deneyimi</p></li>
        <li class="my-6"><p class="text-accent text-lg font-medium">3 <span data-i18n="facts.2u">uzman</span></p><p data-i18n="facts.2">diyetisyen, tek çatı altında</p></li>
        <li class="my-6"><p class="text-accent text-lg font-medium">60 <span data-i18n="facts.3u">dk</span></p><p data-i18n="facts.3">ilk görüşme ve vücut analizi</p></li>
        <li class="my-6"><p class="text-accent text-lg font-medium">7 <span data-i18n="facts.4u">gün</span></p><p data-i18n="facts.4">içinde ilk kontrol, sonra haftalık takip</p></li>
      </ul>
    </section>

    <!-- S4 · Hizmetler (Card + küçük görsel) -->
    <section id="hizmetler" class={SECTION} aria-labelledby="services-title">
      <h2 id="services-title" class={H2} data-i18n="services.title">Çalıştığımız alanlar</h2>
      <p class={LEDE} data-i18n="services.lede">Hazır listeler dağıtmıyoruz. Yaşınızı, hareket düzeninizi, tahlil sonuçlarınızı ve mutfağınızda gerçekten ne olduğunu konuşarak başlıyoruz.</p>
      <ul>
        {services.map((s) => (
          <li class="my-6 flex gap-4">
            <img
              src={getAssetPath(`assets/img/${s.img}-700.webp`)}
              width="700"
              height="525"
              loading="lazy"
              decoding="async"
              class="thumb border-border mt-1 border object-cover"
              alt={T(`s${s.n}.alt`)}
              data-i18n-attr={`alt:s${s.n}.alt`}
            />
            <div class="min-w-0">
              <a href="#randevu" class={CARD_TITLE} data-book-area={s.area} data-book-type={s.type}>
                <h3 data-i18n={`s${s.n}.title`}>{T(`s${s.n}.title`)}</h3>
              </a>
              <div class={META}>
                <span data-i18n={`s${s.n}.foot`}>{T(`s${s.n}.foot`)}</span>
                <span aria-hidden="true">|</span>
                <ul class="tags flex flex-wrap gap-x-2">
                  {s.tags.map((k) => (
                    <li class="flex items-center gap-0.5"><IconHash class="size-4 opacity-80" />{k ? <span data-i18n={k}>{T(k)}</span> : <span>PCOS</span>}</li>
                  ))}
                </ul>
              </div>
              <p data-i18n={`s${s.n}.text`}>{T(`s${s.n}.text`)}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- S5 · Mevsim notları (AstroPaper sadeliği: görselsiz, etiket listesi düzeni) -->
    <section class:list={["notes-panel", SECTION]} aria-labelledby="notes-title">
      <h2 id="notes-title" class={H2} data-i18n="notes.title">Tezgâhlarda incir, nar ve ceviz zamanı.</h2>
      <p class={LEDE} data-i18n="notes.eyebrow">Eylül ve ekim</p>
      <ul class="my-6 flex flex-wrap gap-x-6 gap-y-3 text-lg">
        {[1, 2, 3, 4, 5, 6, 7].map((n) => (
          <li class="flex items-center gap-0.5"><IconHash class="size-5 opacity-80" /><span data-i18n={`notes.c${n}`}>{T(`notes.c${n}`)}</span></li>
        ))}
      </ul>
      <p class="mt-2">
        <LinkButton class={LINK} href="#tarifler"><span data-i18n="notes.p1">Tarifler</span></LinkButton>
        <span aria-hidden="true">&nbsp;·&nbsp;</span>
        <LinkButton class={LINK} href="#program"><span data-i18n="notes.p2">Örnek program</span></LinkButton>
        <span aria-hidden="true">&nbsp;·&nbsp;</span>
        <LinkButton class={LINK} href="#blog"><span data-i18n="notes.p3">Yazılar</span></LinkButton>
      </p>
    </section>

    <!-- S6 · Yaklaşım -->
    <section id="yaklasim" class={SECTION} aria-labelledby="process-title">
      <h2 id="process-title" class={H2} data-i18n="process.title">Görüşmeler nasıl ilerliyor?</h2>
      <p class={LEDE} data-i18n="process.lede">Plan ilk görüşmede bitmiyor. Bayram sofrası, tatil ya da yoğun bir iş haftası geldiğinde kontrol görüşmesinde birlikte güncelliyoruz.</p>
      <div class="app-prose max-w-app">
        <blockquote class="quote">
          <p data-i18n="process.quote">“Danışanlarımın çoğu ne yemesi gerektiğini aşağı yukarı biliyor. Zorlandıkları an, akşam işten aç çıktıkları saat. Planı önce o saate göre kuruyoruz.”</p>
          <footer class="text-foreground">— <span data-i18n="team.selin.name">Uzm. Dyt. Selin Karaca</span> · <span data-i18n="process.quoteRole">kurucu</span></footer>
        </blockquote>
      </div>
      <ol class="road my-6 list-decimal ps-8 marker:text-accent">
        {[1, 2, 3, 4].map((n) => (
          <li class="step my-6">
            <h3 class="text-lg font-medium" data-i18n={`step${n}.title`}>{T(`step${n}.title`)}</h3>
            <div class={META}><span data-i18n={`step${n}.meta`}>{T(`step${n}.meta`)}</span></div>
            <p data-i18n={`step${n}.text`}>{T(`step${n}.text`)}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- S7 · Yöntem sahnesi (manifesto): yalnızca metin -->
    <section id="manifesto" class={SECTION} aria-labelledby="manifesto-title">
      <h2 id="manifesto-title" class={H2} data-i18n="scene.label">Yöntem</h2>
      <div class="app-prose max-w-app">
        <blockquote>
          <p>
            <span data-scene-line data-i18n="scene.l1">Tek bir hafta için değil.</span>
            <span data-scene-line data-i18n="scene.l2">Bayram sofrası için de,</span>
            <span data-scene-line data-i18n="scene.l3">yorgun bir salı akşamı için de</span>
            <span data-scene-line><em data-i18n="scene.l4">çalışan bir plan.</em></span>
          </p>
        </blockquote>
      </div>
      <ul class="scene-foot my-6">
        <li class="my-2"><b class="text-accent font-medium" data-i18n="scene.f1n">60 dk</b> <span data-i18n="scene.f1">ilk görüşme</span></li>
        <li class="my-2"><b class="text-accent font-medium" data-i18n="scene.f2n">48 saat</b> <span data-i18n="scene.f2">içinde kişisel plan</span></li>
        <li class="my-2"><b class="text-accent font-medium" data-i18n="scene.f3n">Haftalık</b> <span data-i18n="scene.f3">kontrol ve mesaj desteği</span></li>
      </ul>
    </section>

    <!-- S8 · Uzmanlar (Card + küçük portre) -->
    <section id="uzmanlar" class={SECTION} aria-labelledby="team-title">
      <h2 id="team-title" class={H2} data-i18n="team.title">Diyetisyenlerimiz</h2>
      <p class={LEDE} data-i18n="team.lede">Her uzmanın ağırlıklı çalıştığı alan farklı. Randevu alırken konunuzu seçtiğinizde size uygun uzmanlar öne çıkar.</p>
      <ul>
        {["selin", "emre", "zeynep"].map((p) => (
          <li class="person my-6 flex gap-4">
            <img
              src={getAssetPath(`assets/img/uzman-${p}-560.webp`)}
              width="560"
              height="700"
              loading="lazy"
              decoding="async"
              class="portrait border-border mt-1 border object-cover"
              alt={T(`team.${p}.alt`)}
              data-i18n-attr={`alt:team.${p}.alt`}
            />
            <div class="min-w-0">
              <h3 class="text-lg font-medium" data-i18n={`team.${p}.name`}>{T(`team.${p}.name`)}</h3>
              <div class={META}>
                <span data-i18n={`team.${p}.area`}>{T(`team.${p}.area`)}</span>
                {p === "selin" && (<><span aria-hidden="true">|</span><span data-i18n="team.founder">Kurucu</span></>)}
              </div>
              <p data-i18n={`team.${p}.bio`}>{T(`team.${p}.bio`)}</p>
              <dl class="person-facts my-2 text-sm">
                <div><dt data-i18n="team.edu">Eğitim</dt><dd data-i18n={`team.${p}.edu`}>{T(`team.${p}.edu`)}</dd></div>
                <div><dt data-i18n="team.days">Günler</dt><dd data-i18n={`team.${p}.days`}>{T(`team.${p}.days`)}</dd></div>
                <div><dt data-i18n="team.langs">Dil</dt><dd data-i18n={`team.${p}.langs`}>{T(`team.${p}.langs`)}</dd></div>
              </dl>
              <LinkButton class={LINK} href="#randevu" data-book-staff={p}>
                <span data-i18n={`team.${p}.btn`}>{T(`team.${p}.btn`)}</span>
                <IconArrowRight class="inline-block size-5 rtl:-rotate-180" />
              </LinkButton>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- S9 · Araçlar (diyetisyen-v2 işaretlemesi, AstroPaper tokenlarıyla giydirildi) -->
    <section id="araclar" class={SECTION} aria-labelledby="tools-title">
      <h2 id="tools-title" class={H2} data-i18n="tools.title">Hesaplama araçları</h2>
      <p class={LEDE} data-i18n="tools.lede">Bu hesaplamalar genel bir fikir verir. Görüşmede aynı değerleri vücut analizi ve tahlillerinizle birlikte yorumluyoruz.</p>
      <div class="tools-head">
          <div class="tabs" role="tablist" data-i18n-attr="aria-label:tools.aria" aria-label="Sağlık hesaplama araçları">
            <button class="tab" role="tab" type="button" id="tab-bmi" aria-controls="tool-bmi" aria-selected="true"><span data-i18n="tools.tab1">Vücut kitle indeksi</span><span class="mono" data-i18n="tools.tab1abbr">VKİ</span></button>
            <button class="tab" role="tab" type="button" id="tab-kcal" aria-controls="tool-kcal" aria-selected="false" tabindex="-1"><span data-i18n="tools.tab2">Günlük kalori</span><span class="mono">KCAL</span></button>
            <button class="tab" role="tab" type="button" id="tab-water" aria-controls="tool-water" aria-selected="false" tabindex="-1"><span data-i18n="tools.tab3">Su ihtiyacı</span><span class="mono">ML</span></button>
          </div>
        </div>

        <!-- BMI -->
        <div class="tool" role="tabpanel" id="tool-bmi" aria-labelledby="tab-bmi">
          <form class="tool-card tool-form" data-tool="bmi" novalidate>
            <div class="range-field">
              <div class="range-top">
                <label class="field-label" for="bmi-height" data-i18n="tools.height">Boy</label>
                <div class="field-unit"><input class="field" id="bmi-height" name="height" type="number" inputmode="decimal" min="120" max="220" step="1" value="168"><span>cm</span></div>
              </div>
              <input type="range" min="120" max="220" step="1" value="168" data-sync="height" data-i18n-attr="aria-label:tools.height" aria-label="Boy">
            </div>
            <div class="range-field">
              <div class="range-top">
                <label class="field-label" for="bmi-weight" data-i18n="tools.weight">Kilo</label>
                <div class="field-unit"><input class="field" id="bmi-weight" name="weight" type="number" inputmode="decimal" min="35" max="220" step="0.1" value="68"><span>kg</span></div>
              </div>
              <input type="range" min="35" max="200" step="0.5" value="68" data-sync="weight" data-i18n-attr="aria-label:tools.weight" aria-label="Kilo">
            </div>
            <p class="tool-note" data-i18n="tools.bmiNote">VKİ; 18 yaş altı, gebelik dönemi ve kas kütlesi yüksek sporcular için yanıltıcı olabilir.</p>
          </form>
          <div class="tool-card tool-result" data-result="bmi" aria-live="polite"></div>
        </div>

        <!-- Calories -->
        <div class="tool" role="tabpanel" id="tool-kcal" aria-labelledby="tab-kcal" hidden>
          <form class="tool-card tool-form" data-tool="kcal" novalidate>
            <div class="field-group">
              <span class="field-label" id="kcal-sex-l" data-i18n="tools.sex">Cinsiyet</span>
              <div class="radio-row" role="radiogroup" aria-labelledby="kcal-sex-l">
                <label class="radio-pill"><input type="radio" name="sex" value="f" checked><span data-i18n="tools.female">Kadın</span></label>
                <label class="radio-pill"><input type="radio" name="sex" value="m"><span data-i18n="tools.male">Erkek</span></label>
              </div>
            </div>
            <div class="form-grid form-grid--2">
              <div class="field-group">
                <label class="field-label" for="kcal-age" data-i18n="tools.age">Yaş</label>
                <div class="field-unit"><input class="field" id="kcal-age" name="age" type="number" inputmode="numeric" min="18" max="90" value="32"><span data-i18n="tools.years">yaş</span></div>
              </div>
              <div class="field-group">
                <label class="field-label" for="kcal-height" data-i18n="tools.height">Boy</label>
                <div class="field-unit"><input class="field" id="kcal-height" name="height" type="number" inputmode="decimal" min="120" max="220" value="168"><span>cm</span></div>
              </div>
              <div class="field-group span-2">
                <label class="field-label" for="kcal-weight" data-i18n="tools.weight">Kilo</label>
                <div class="field-unit"><input class="field" id="kcal-weight" name="weight" type="number" inputmode="decimal" min="35" max="220" step="0.1" value="68"><span>kg</span></div>
              </div>
            </div>
            <div class="field-group">
              <label class="field-label" for="kcal-activity" data-i18n="tools.activity">Hareket düzeni</label>
              <div class="select-wrap">
                <select class="field" id="kcal-activity" name="activity">
                  <option value="1.2" data-i18n="tools.act1">Hareketsiz (masa başı, egzersiz yok)</option>
                  <option value="1.375" data-i18n="tools.act2">Hafif aktif (haftada 1–3 gün)</option>
                  <option value="1.55" selected data-i18n="tools.act3">Orta aktif (haftada 3–5 gün)</option>
                  <option value="1.725" data-i18n="tools.act4">Çok aktif (haftada 6–7 gün)</option>
                  <option value="1.9" data-i18n="tools.act5">Ekstra aktif (ağır iş veya günde iki antrenman)</option>
                </select>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </div>
            </div>
            <div class="field-group">
              <span class="field-label" id="kcal-goal-l" data-i18n="tools.goal">Hedef</span>
              <div class="radio-row" role="radiogroup" aria-labelledby="kcal-goal-l">
                <label class="radio-pill"><input type="radio" name="goal" value="lose" checked><span data-i18n="tools.lose">Kilo vermek</span></label>
                <label class="radio-pill"><input type="radio" name="goal" value="keep"><span data-i18n="tools.keep">Korumak</span></label>
                <label class="radio-pill"><input type="radio" name="goal" value="gain"><span data-i18n="tools.gain">Kilo almak</span></label>
              </div>
            </div>
          </form>
          <div class="tool-card tool-result" data-result="kcal" aria-live="polite"></div>
        </div>

        <!-- Water -->
        <div class="tool" role="tabpanel" id="tool-water" aria-labelledby="tab-water" hidden>
          <form class="tool-card tool-form" data-tool="water" novalidate>
            <div class="range-field">
              <div class="range-top">
                <label class="field-label" for="water-weight" data-i18n="tools.weight">Kilo</label>
                <div class="field-unit"><input class="field" id="water-weight" name="weight" type="number" inputmode="decimal" min="35" max="220" step="0.1" value="68"><span>kg</span></div>
              </div>
              <input type="range" min="35" max="200" step="0.5" value="68" data-sync="weight" data-i18n-attr="aria-label:tools.weight" aria-label="Kilo">
            </div>
            <div class="range-field">
              <div class="range-top">
                <label class="field-label" for="water-exercise" data-i18n="tools.exercise">Günlük egzersiz</label>
                <div class="field-unit"><input class="field" id="water-exercise" name="exercise" type="number" inputmode="numeric" min="0" max="240" step="5" value="30"><span data-i18n="tools.min">dk</span></div>
              </div>
              <input type="range" min="0" max="180" step="15" value="30" data-sync="exercise" data-i18n-attr="aria-label:tools.exercise" aria-label="Günlük egzersiz">
            </div>
            <div class="field-group">
              <span class="field-label" id="water-climate-l" data-i18n="tools.climate">Hava</span>
              <div class="radio-row" role="radiogroup" aria-labelledby="water-climate-l">
                <label class="radio-pill"><input type="radio" name="climate" value="normal" checked><span data-i18n="tools.normal">Normal</span></label>
                <label class="radio-pill"><input type="radio" name="climate" value="hot"><span data-i18n="tools.hot">Sıcak / nemli</span></label>
              </div>
            </div>
            <div class="field-group">
              <span class="field-label" id="water-status-l" data-i18n="tools.status">Özel durum</span>
              <div class="radio-row" role="radiogroup" aria-labelledby="water-status-l">
                <label class="radio-pill"><input type="radio" name="status" value="none" checked><span data-i18n="tools.none">Yok</span></label>
                <label class="radio-pill"><input type="radio" name="status" value="pregnant"><span data-i18n="tools.pregnant">Gebelik</span></label>
                <label class="radio-pill"><input type="radio" name="status" value="nursing"><span data-i18n="tools.nursing">Emzirme</span></label>
              </div>
            </div>
          </form>
          <div class="tool-card tool-result" data-result="water" aria-live="polite"></div>
        </div>
    </section>

    <!-- S10 · Örnek program -->
    <section id="program" class={SECTION} aria-labelledby="program-title">
      <div class="print-scope">
        <h2 id="program-title" class={H2} data-i18n="program.title">Bir haftalık örnek menü</h2>
        <p class={LEDE} data-i18n="program.lede">Üç farklı hedef için hazırladığımız örnek haftalar. Porsiyonlar ortalama bir yetişkine göredir; size özel plan görüşmede hazırlanır.</p>
        <div class="program-top">
          <div class="segmented" role="radiogroup" data-i18n-attr="aria-label:program.aria" aria-label="Program hedefi" data-plans>
            <button type="button" role="radio" aria-checked="true" data-plan="lose"><span data-i18n="program.lose">Kilo verme</span><small data-i18n="program.k1">~1.500 kcal</small></button>
            <button type="button" role="radio" aria-checked="false" data-plan="balance" tabindex="-1"><span data-i18n="program.balance">Dengeli</span><small data-i18n="program.k2">~1.900 kcal</small></button>
            <button type="button" role="radio" aria-checked="false" data-plan="sport" tabindex="-1"><span data-i18n="program.sport">Sporcu</span><small data-i18n="program.k3">~2.500 kcal</small></button>
          </div>
          <div class="day-tabs" role="tablist" data-i18n-attr="aria-label:program.days" aria-label="Haftanın günleri" data-days></div>
        </div>

        <div class="program" id="program-print">
          <ol class="meals" data-meals aria-live="polite"></ol>
          <aside class="program-side">
            <div class="tool-card">
              <p class="label" data-i18n="program.total">Günlük toplam</p>
              <p class="program-total"><b data-total>0</b><span class="mono">kcal</span></p>
              <div class="macro-bars" data-macros></div>
            </div>
            <div class="program-tip">
              <p class="label" data-i18n="program.tip">Günün notu</p>
              <p data-tip></p>
            </div>
            <div class="program-actions">
              <button type="button" class="btn btn--ghost btn--sm" data-print-program>
                <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9V3h12v6"/><rect x="3" y="9" width="18" height="8" rx="2"/><path d="M7 14h10v7H7z"/></svg>
                <span data-i18n="program.print">Yazdır</span>
              </button>
              <a class="btn btn--primary btn--sm" href="#randevu" data-book-area="weight" data-program-book data-i18n="program.book">Bu hedefle randevu al</a>
            </div>
          </aside>
        </div>
        <p class="disclaimer" data-i18n="program.disclaimer">Bu menüler genel bir örnektir; gebelik, kronik hastalık, ilaç kullanımı veya 18 yaş altı gibi durumlarda doğrudan uygulanmamalıdır. Değerler yaklaşıktır.</p>
      </div>
    </section>

    <!-- S11 · Tarifler -->
    <section id="tarifler" class={SECTION} aria-labelledby="recipes-title">
      <h2 id="recipes-title" class={H2} data-i18n="recipes.title">Hafta içi akşamlarına sığan tarifler</h2>
      <p class={LEDE} data-i18n="recipes.lede">Çoğu 30 dakikadan kısa sürüyor ve malzemeleri mahalle marketinde bulunuyor. Her tarifte porsiyon başına besin değerleri var.</p>
      <div class="filter-row" role="group" data-i18n-attr="aria-label:recipes.filter" aria-label="Tarif kategorisi" data-recipe-filters>
          <button type="button" class="chip" aria-pressed="true" data-cat="all" data-i18n="recipes.all">Tümü</button>
          <button type="button" class="chip" aria-pressed="false" data-cat="breakfast" data-i18n="recipes.breakfast">Kahvaltı</button>
          <button type="button" class="chip" aria-pressed="false" data-cat="main" data-i18n="recipes.main">Ana yemek</button>
          <button type="button" class="chip" aria-pressed="false" data-cat="soup" data-i18n="recipes.soup">Çorba ve salata</button>
          <button type="button" class="chip" aria-pressed="false" data-cat="snack" data-i18n="recipes.snack">Ara öğün</button>
          <button type="button" class="chip" aria-pressed="false" data-cat="dessert" data-i18n="recipes.dessert">Tatlı</button>
        </div>
        <div class="recipes" data-recipes></div>
    </section>

    <!-- S12 · Ücretler (Card + düz liste) -->
    <section id="ucretler" class={SECTION} aria-labelledby="pricing-title">
      <h2 id="pricing-title" class={H2} data-i18n="pricing.title">Görüşme ücretleri</h2>
      <p class={LEDE} data-i18n="pricing.lede">Görüşme ücretlerini baştan paylaşıyoruz. Online görüşmeler, yüz yüze görüşmelerle aynı içeriktedir.</p>
      <ul class="plans">
        {[
          { n: 1, price: "1.800", per: null, feats: 4, btn: "plan1.btn" },
          { n: 2, price: "5.400", per: "plan2.per", feats: 5, btn: "plan2.btn" },
          { n: 3, price: "14.900", per: null, feats: 5, btn: "plan3.btn" },
        ].map((p) => (
          <li class="plan my-6">
            <h3 class="text-lg font-medium" data-i18n={`plan${p.n}.label`}>{T(`plan${p.n}.label`)}</h3>
            <p class="price text-accent text-xl font-semibold">
              <span data-i18n={`price.p${p.n}`}>{p.price}</span>
              {p.per ? <small class="text-sm font-medium" data-i18n={p.per}>TL / ay</small> : <small class="text-sm font-medium">TL</small>}
            </p>
            <div class={META}><span data-i18n={`plan${p.n}.sub`}>{T(`plan${p.n}.sub`)}</span></div>
            <ul class="feats my-2 list-disc ps-6 marker:text-accent">
              {Array.from({ length: p.feats }, (_, i) => <li data-i18n={`plan${p.n}.f${i + 1}`}>{T(`plan${p.n}.f${i + 1}`)}</li>)}
            </ul>
            <LinkButton class={LINK} href="#randevu" data-book-type="first">
              <span data-i18n={p.btn}>{T(p.btn)}</span>
              <IconArrowRight class="inline-block size-5 rtl:-rotate-180" />
            </LinkButton>
          </li>
        ))}
      </ul>
      <div class="strip my-6">
        <h3 class="text-lg font-medium" data-i18n="pricing.corpTitle">Kurumsal beslenme programları</h3>
        <p data-i18n="pricing.corpText">Şirket çalışanlarına yönelik seminer ve bireysel görüşme paketleri için ayrıca teklif hazırlıyoruz.</p>
        <LinkButton class={LINK} href="#iletisim" data-contact-topic="corporate">
          <span data-i18n="pricing.corpBtn">Teklif isteyin</span>
          <IconArrowRight class="inline-block size-5 rtl:-rotate-180" />
        </LinkButton>
      </div>
      <div class="incl my-6">
        <h3 class="text-lg font-medium" data-i18n="incl.title">Neler dahil, neler değil?</h3>
        <p class="italic" data-i18n="incl.text">Sonradan ek ücret çıkmaması için baştan netleştiriyoruz.</p>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <div>
            <p class="font-medium" data-i18n="incl.yes">Dahil</p>
            <ul class="incl-list my-2 list-disc ps-6 marker:text-accent">
              {[1, 2, 3, 4, 5].map((i) => <li data-i18n={`incl.y${i}`}>{T(`incl.y${i}`)}</li>)}
            </ul>
          </div>
          <div>
            <p class="font-medium" data-i18n="incl.no">Dahil değil</p>
            <ul class="incl-list incl-list--no my-2 list-[circle] ps-6 marker:text-muted-foreground">
              {[1, 2, 3, 4].map((i) => <li data-i18n={`incl.n${i}`}>{T(`incl.n${i}`)}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- S13 · Randevu -->
    <section id="randevu" class:list={["booking-panel", SECTION]} aria-labelledby="booking-title">
      <h2 id="booking-title" class={H2} data-i18n="booking.title">Online randevu</h2>
      <p class={LEDE} data-i18n="booking.lede">Uzmanların boş saatlerini görüp randevunuzu buradan ayırabilirsiniz. Aynı gün için en erken bir saat sonrasına randevu verilebiliyor.</p>
      <div class="clock-card">
            <span class="label"><span class="live-dot" aria-hidden="true"></span><span data-i18n="booking.now">Şu an · Türkiye saati</span></span>
            <span class="clock" data-clock aria-live="off">--:--</span>
            <span class="clock-date" data-clock-date>&nbsp;</span>
          </div>
      <div class="booking" data-booking>
          <ol class="stepper" data-stepper>
            <li class="is-current"><button type="button" data-goto="1" aria-current="step"><span>1</span><b class="step-text" data-i18n="booking.s1">Görüşme</b></button></li>
            <li><button type="button" data-goto="2" disabled><span>2</span><b class="step-text" data-i18n="booking.s2">Tarih ve saat</b></button></li>
            <li><button type="button" data-goto="3" disabled><span>3</span><b class="step-text" data-i18n="booking.s3">Bilgiler</b></button></li>
            <li><button type="button" data-goto="4" disabled><span>4</span><b class="step-text" data-i18n="booking.s4">Onay</b></button></li>
          </ol>

          <div class="booking-grid">
            <form class="booking-main" id="booking-form" novalidate data-i18n-attr="aria-label:booking.formAria" aria-label="Randevu formu">
              <!-- Step 1 -->
              <fieldset class="bstep" data-step="1">
                <legend class="bstep-title" tabindex="-1" data-i18n="booking.q1">Nasıl bir görüşme istiyorsunuz?</legend>
                <div class="choice-grid choice-grid--3">
                  <label class="choice">
                    <input type="radio" name="type" value="first" checked>
                    <span class="choice-box">
                      <span class="choice-top"><span class="choice-title" data-i18n="type.first">İlk görüşme</span><span class="choice-radio" aria-hidden="true"></span></span>
                      <span class="choice-desc" data-i18n="type.firstDesc">Sağlık geçmişi, vücut analizi ve kişisel planın hazırlanması.</span>
                      <span class="choice-meta"><span data-i18n="type.firstMeta">60 dk · Klinikte</span><span data-i18n="price.first">1.800 TL</span></span>
                    </span>
                  </label>
                  <label class="choice">
                    <input type="radio" name="type" value="control">
                    <span class="choice-box">
                      <span class="choice-top"><span class="choice-title" data-i18n="type.control">Kontrol görüşmesi</span><span class="choice-radio" aria-hidden="true"></span></span>
                      <span class="choice-desc" data-i18n="type.controlDesc">Daha önce görüştüğümüz danışanlar için ölçüm ve plan güncellemesi.</span>
                      <span class="choice-meta"><span data-i18n="type.controlMeta">30 dk · Klinikte</span><span data-i18n="price.control">900 TL</span></span>
                    </span>
                  </label>
                  <label class="choice">
                    <input type="radio" name="type" value="online">
                    <span class="choice-box">
                      <span class="choice-top"><span class="choice-title" data-i18n="type.online">Online görüşme</span><span class="choice-radio" aria-hidden="true"></span></span>
                      <span class="choice-desc" data-i18n="type.onlineDesc">Görüntülü görüşme; bağlantı randevudan önce e-postanıza gelir.</span>
                      <span class="choice-meta"><span data-i18n="type.onlineMeta">45 dk · Online</span><span data-i18n="price.online">1.500 TL</span></span>
                    </span>
                  </label>
                </div>

                <h3 class="bstep-sub"><span data-i18n="booking.area">Konu</span></h3>
                <div class="radio-row" role="radiogroup" data-i18n-attr="aria-label:booking.area" aria-label="Konu">
                  <label class="radio-pill"><input type="radio" name="area" value="weight" checked><span data-i18n="area.weight">Kilo yönetimi</span></label>
                  <label class="radio-pill"><input type="radio" name="area" value="clinical"><span data-i18n="area.clinical">Klinik beslenme</span></label>
                  <label class="radio-pill"><input type="radio" name="area" value="sports"><span data-i18n="area.sports">Sporcu beslenmesi</span></label>
                  <label class="radio-pill"><input type="radio" name="area" value="pregnancy"><span data-i18n="area.pregnancy">Gebelik ve emzirme</span></label>
                  <label class="radio-pill"><input type="radio" name="area" value="kids"><span data-i18n="area.kids">Çocuk ve ergen</span></label>
                  <label class="radio-pill"><input type="radio" name="area" value="other"><span data-i18n="area.other">Diğer</span></label>
                </div>

                <h3 class="bstep-sub"><span data-i18n="booking.staff">Uzman</span><span class="hint" data-i18n="booking.staffHint">Konunuza göre uygun uzmanlar seçilebilir</span></h3>
                <div class="choice-grid choice-grid--4" data-staff-choices>
                  <label class="choice staff-choice">
                    <input type="radio" name="staff" value="any" checked>
                    <span class="choice-box">
                      <span class="staff-any" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0"/><circle cx="17" cy="9" r="2.6"/><path d="M15.8 14.2A4.6 4.6 0 0 1 21 19"/></svg></span>
                      <span><span class="choice-title" data-i18n="staff.any">Fark etmez</span><br><span class="staff-note" data-i18n="staff.anyNote">İlk uygun uzman</span></span>
                    </span>
                  </label>
                  <label class="choice staff-choice">
                    <input type="radio" name="staff" value="selin">
                    <span class="choice-box">
                      <img src="assets/img/uzman-selin-560.webp" width="52" height="52" loading="lazy" alt="">
                      <span><span class="choice-title">Selin Karaca</span><br><span class="staff-note" data-staff-note="selin" data-i18n="staff.selinDays">Pzt – Cum</span></span>
                    </span>
                  </label>
                  <label class="choice staff-choice">
                    <input type="radio" name="staff" value="emre">
                    <span class="choice-box">
                      <img src="assets/img/uzman-emre-560.webp" width="52" height="52" loading="lazy" alt="">
                      <span><span class="choice-title">Emre Aksoy</span><br><span class="staff-note" data-staff-note="emre" data-i18n="staff.emreDays">Sal, Per, Cmt</span></span>
                    </span>
                  </label>
                  <label class="choice staff-choice">
                    <input type="radio" name="staff" value="zeynep">
                    <span class="choice-box">
                      <img src="assets/img/uzman-zeynep-560.webp" width="52" height="52" loading="lazy" alt="">
                      <span><span class="choice-title">Zeynep Tunalı</span><br><span class="staff-note" data-staff-note="zeynep" data-i18n="staff.zeynepDays">Pzt, Çar, Cum, Cmt</span></span>
                    </span>
                  </label>
                </div>

                <div class="bstep-nav">
                  <button type="button" class="btn btn--primary" data-next="2"><span data-i18n="booking.next1">Devam: tarih seçin</span><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
                </div>
              </fieldset>

              <!-- Step 2 -->
              <fieldset class="bstep" data-step="2" hidden>
                <legend class="bstep-title" tabindex="-1" data-i18n="booking.q2">Gün ve saat seçin</legend>
                <p class="tz-note" data-tz-note hidden></p>
                <div class="datetime">
                  <div class="cal" data-calendar></div>
                  <div class="slots" data-slots aria-live="polite"></div>
                </div>
                <div class="bstep-nav">
                  <button type="button" class="btn btn--ghost" data-prev="1" data-i18n="booking.back">Geri</button>
                  <p class="bstep-msg" data-msg="2" role="alert"></p>
                  <button type="button" class="btn btn--primary" data-next="3"><span data-i18n="booking.next2">Devam: bilgileriniz</span><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
                </div>
              </fieldset>

              <!-- Step 3 -->
              <fieldset class="bstep" data-step="3" hidden>
                <legend class="bstep-title" tabindex="-1" data-i18n="booking.q3">Bilgileriniz</legend>
                <div class="form-grid form-grid--2">
                  <div class="field-group span-2">
                    <label class="field-label" for="b-name" data-i18n="form.name">Ad soyad</label>
