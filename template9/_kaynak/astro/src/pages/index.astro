          </div>
        </div>
        <button type="submit" class="btn btn--primary"><span class="btn-spinner" aria-hidden="true"></span><span data-i18n="cancel.btn">Randevuyu iptal et</span></button>
        <p class="form-status" data-cancel-status role="status" aria-live="polite"></p>
      </form>
    </div>
  </dialog>
</Layout>
