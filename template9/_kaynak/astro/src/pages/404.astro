---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getAssetPath } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

// AstroPaper src/pages/404.astro (metinler TR/EN).
const t = useTranslations(config.site.lang);
---

<Layout
  title={`${t.notFound.title} | ${config.site.title}`}
  titleEn="404 Not Found | Mizan Nutrition"
  canonicalURL="https://sadikbesler.github.io/50-website/template9/404.html"
>
  <Header />

  <main
    id="main-content"
    class="app-layout my-1 flex flex-1 items-center justify-center"
  >
    <div class="mb-14 flex flex-col items-center justify-center">
      <h1 class="text-accent text-9xl font-bold">404</h1>
      <span aria-hidden="true"> ¯\_(ツ)_/¯ </span>
      <p class="mt-4 text-2xl sm:text-3xl" data-i18n="ap.notFound.message">{t.notFound.message}</p>
      <LinkButton
        href={getAssetPath("")}
        class="my-6 text-lg underline decoration-dashed underline-offset-8"
      >
        <span data-i18n="ap.notFound.goHome">{t.notFound.goHome}</span>
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>
